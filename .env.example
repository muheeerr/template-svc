# ═══════════════════════════════════════════════════════════════════════
# Environment Variables — projectname Service
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Never commit real secrets to source control.
# ═══════════════════════════════════════════════════════════════════════

# ─── REQUIRED ─────────────────────────────────────────────────────────

# JWT authentication (symmetric signing key, min 32 characters)
JWT_KEY=<base64-encoded-256-bit-key>
JWT_ISSUER=https://your-service.example.com
JWT_AUDIENCE=your-service-api
JWT_ACCESS_TOKEN_EXPIRATION_IN_MINUTES=10
JWT_REFRESH_TOKEN_EXPIRATION_IN_DAYS=7

# PostgreSQL connection string
DBHost=Host=localhost;Port=5432;Database=projectnameDev;Username=postgres;Password=postgres

# Email (SMTP via MailKit)
SenderEmail=noreply@example.com
SenderPassword=<app-specific-password>

# AES encryption key (base64-encoded, 256-bit)
AES_KEY=<base64-encoded-256-bit-aes-key>

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ─── OPTIONAL ─────────────────────────────────────────────────────────

# Redis (defaults to localhost:6379 if not set in some code paths)
RedisHost=localhost:6379

# SMTP server settings (defaults: localhost:1025 for Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025

# Scalar API docs — pre-filled Bearer token for the "Try it" UI
SCALAR_BEARER_TOKEN=

# Slack alerting — webhook URL for exception notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Server URL (used in Scalar docs server list)
SERVER_URL=https://api.example.com

# Seq structured log ingestion
SEQ_URL=http://localhost:5341

# OpenTelemetry (OTLP exporter, only sends data when set)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=projectname
OTEL_SERVICE_VERSION=1.0.0

# gRPC auth service address
AUTH_SERVICE_URL=localhost:7089

# Database seeding (only runs in Development + when "true")
SEED_DATABASE=true

# API versioning default (e.g. "1.0")
DEFAULT_API_VERSION=1.0

# Response compression level: Optimal | Fastest | SmallestSize | NoCompression
COMPRESSION_LEVEL=Optimal

# Health check paths
HEALTH_CHECK_PATH=/health
HEALTH_READY_PATH=/health/ready
HEALTH_LIVE_PATH=/health/live

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=__YOUR_AWS_ACCESS_KEY__
AWS_SECRET_ACCESS_KEY=__YOUR_AWS_SECRET_KEY__
AWS_REGION=us-east-1
S3_BUCKET_NAME=__your-bucket-name__

# Rate limiting (requests per minute per IP, default: 100)
RATE_LIMIT_PERMIT_COUNT=100
